# Copy this file to .env before starting the server.

# Port the backend API listens on.
PORT=4000

# Secret used to sign login tokens. Change this to any long random string
# before deploying for real.
JWT_SECRET=change-this-to-a-long-random-string

# How long a login stays valid for.
JWT_EXPIRES_IN=7d

# Where LibreTranslate is running, if you use the translation feature.
LIBRETRANSLATE_URL=http://localhost:5000
